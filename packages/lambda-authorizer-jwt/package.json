{
  "name": "@yingyeothon/lambda-authorizer-jwt",
  "version": "2.0.1",
  "description": "JWT-issuing and JWT-verifying AWS API Gateway custom authorizers, including the REQUEST authorizer a WebSocket $connect route requires.",
  "keywords": [
    "yyt",
    "yingyeothon"
  ],
  "license": "MIT",
  "author": "yingyeothon",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.base.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yingyeothon/lambda-authorizer": "workspace:^",
    "@yingyeothon/logger": "workspace:^",
    "jsonwebtoken": "^9.0.2",
    "@types/aws-lambda": "^8.10.152",
    "@types/jsonwebtoken": "^9.0.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingyeothon/tslib.git",
    "directory": "packages/lambda-authorizer-jwt"
  },
  "homepage": "https://github.com/yingyeothon/tslib/tree/main/packages/lambda-authorizer-jwt#readme"
}
