{
  "name": "@yingyeothon/actor-system-redis",
  "version": "2.0.0",
  "description": "Redis-backed queue, lock, and awaiter for @yingyeothon/actor-system (formerly @yingyeothon/actor-system-redis-support).",
  "keywords": [
    "yyt",
    "yingyeothon"
  ],
  "license": "MIT",
  "author": "yingyeothon",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.base.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yingyeothon/actor-system": "workspace:^",
    "@yingyeothon/codec": "workspace:^",
    "@yingyeothon/logger": "workspace:^",
    "@yingyeothon/naive-redis": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingyeothon/tslib.git",
    "directory": "packages/actor-system-redis"
  },
  "homepage": "https://github.com/yingyeothon/tslib/tree/main/packages/actor-system-redis#readme"
}
