{
  "name": "@yingyeothon/logger-slack",
  "version": "2.0.0",
  "description": "Slack incoming-webhook LogWriter and Logger for the @yingyeothon/logger contract, batching records onto a single flushable promise chain.",
  "keywords": [
    "yyt",
    "yingyeothon"
  ],
  "license": "MIT",
  "author": "yingyeothon",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.base.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yingyeothon/logger": "workspace:*",
    "serialize-error": "^8.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingyeothon/tslib.git",
    "directory": "packages/logger-slack"
  },
  "homepage": "https://github.com/yingyeothon/tslib/tree/main/packages/logger-slack#readme"
}
