{
  "name": "@yingyeothon/aws-lambda-custom-authorizer",
  "version": "0.0.0",
  "description": "Helpers for AWS API Gateway custom authorizers: policy builders, token parsers, and error handling.",
  "keywords": [
    "yyt",
    "yingyeothon"
  ],
  "license": "MIT",
  "author": "yingyeothon",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.base.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yingyeothon/logger": "workspace:^",
    "@types/aws-lambda": "^8.10.152"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingyeothon/yyt-tslib.git",
    "directory": "packages/aws-lambda-custom-authorizer"
  },
  "homepage": "https://github.com/yingyeothon/yyt-tslib/tree/main/packages/aws-lambda-custom-authorizer#readme"
}
