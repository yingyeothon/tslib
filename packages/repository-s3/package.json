{
  "name": "@yingyeothon/repository-s3",
  "version": "0.0.0",
  "description": "S3-backed implementation of the @yingyeothon/repository abstractions.",
  "keywords": [
    "yyt",
    "yingyeothon"
  ],
  "license": "MIT",
  "author": "yingyeothon",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.base.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yingyeothon/codec": "workspace:^",
    "@yingyeothon/repository": "workspace:^"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.879.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.879.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingyeothon/tslib.git",
    "directory": "packages/repository-s3"
  },
  "homepage": "https://github.com/yingyeothon/tslib/tree/main/packages/repository-s3#readme"
}
