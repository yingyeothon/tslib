    "@vitest/coverage-v8": "^3.2.4",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.34.0",
    "globals": "^17.11.0",
    "mermaid": "^11.17.2",
    "prettier": "^3.6.2",
    "testcontainers": "^11.5.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "undici": "^7.13.0",
    "vitest": "^3.2.4"
